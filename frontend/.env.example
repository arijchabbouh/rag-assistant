# Development only (npm run dev). Copy to .env.local to change a value.
# Where Vite forwards /ask, /feedback and /health (the FastAPI server, api.py):
API_PROXY_TARGET=http://localhost:8000
# Leave VITE_API_URL unset: the page then calls its own origin. Set it only to call an API on another origin
# (that origin must be in the API's ALLOWED_ORIGINS):
# VITE_API_URL=http://localhost:8000
